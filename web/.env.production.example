# Нужно, ТОЛЬКО если mp3 лежат в отдельном хранилище (например, Cloudflare R2).
# Для Cloudflare Pages (npm run build:pages) не нужно: mp3 кладутся рядом с сайтом.
# Скопируйте в .env.production и укажите адрес хранилища с mp3.
# Внутри должны быть те же папки, что в EL/audio: stories/..., words/...
VITE_AUDIO_URL=https://your-bucket.example.com
