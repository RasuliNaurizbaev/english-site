# Системные файлы
.DS_Store
__pycache__/
*.pyc

# Сайт на Vue: библиотеки (npm install), сборка (npm run build), личные настройки сервера
web/node_modules/
web/dist/
web/.env.production
.dev.vars
tools/.env

# mp3 — в Supabase Storage (tools/upload_audio.py); главная копия — папка audio/ на компьютере.
# json с таймингами (audio/**/*.json) остаются в git: из них build_site_data.py собирает данные сайта.
audio/**/*.mp3

# Копии данных базы перед миграциями (npx supabase db dump) — личные данные, не в git
backups/
